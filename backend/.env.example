# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → Database → Connection string → URI
#
# Usar el SESSION POOLER (host aws-0-<región>.pooler.supabase.com, puerto 5432).
#  · La conexión directa (db.<ref>.supabase.co) es IPv6-only y falla con
#    ENETUNREACH desde la mayoría de redes domésticas.
#  · El transaction pooler (puerto 6543) rompe los prepared statements de
#    node-postgres, que es lo que usa el DataLoader de forma intensiva.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Servidor ────────────────────────────────────────────────────────────────
PORT=4000

# Orígenes permitidos por CORS, separados por coma. 5173 = Vite.
CORS_ORIGIN=http://localhost:5173

# ── Autenticación ───────────────────────────────────────────────────────────
# Cadena larga y aleatoria. En producción NO debe versionarse.
JWT_SECRET=cambiar-por-una-cadena-larga-y-aleatoria

# ── Demostración ────────────────────────────────────────────────────────────
# Retardo artificial de la proyección del modelo de lectura, en milisegundos.
# 0 = comportamiento normal. 1500 hace visible la consistencia eventual en la
# interfaz, útil al grabar la sustentación.
PROJECTION_DELAY_MS=0
